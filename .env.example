# MongoDB Configuration
MONGODB_URI=your_mongodb_connection_string

# JWT Configuration — [Vulnerability 8 FIX] secrets & expiry live here, not in source code
# (required — use long random values, never commit real secrets)
JWT_SECRET=your_jwt_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Groq (optional – for ranger suggested actions; fallback rules used if not set)
GROQ_API_KEY=your_groq_api_key

# Server Configuration
PORT=5000

# Browser origins allowed to call this API (comma-separated, no spaces required)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
